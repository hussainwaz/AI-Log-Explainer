# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional overrides
FRONTEND_URL=http://localhost:3000

# The model the picker starts on; the UI can switch to anything in
# config.MODEL_CHOICES. Not a free slug: OpenRouter withdrew the ones this
# project used to default to, and a dead default 404s on the first request.
# Nemo is about $0.00003 a run.
DEFAULT_MODEL=mistralai/mistral-nemo

# Reasoning models spend part of this budget thinking, and that spend counts
# here. Below roughly 3000 a reasoning model can run out mid-thought and
# return truncated JSON.
MAX_TOKENS=4000

TEMPERATURE=0.0
