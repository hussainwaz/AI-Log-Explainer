# Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...

# Optional overrides
FRONTEND_URL=http://localhost:3000

# The model the picker starts on. Free by default so a clone with no credit
# still works; the UI can switch to any model in config.MODEL_CHOICES.
DEFAULT_MODEL=deepseek/deepseek-r1:free

# Reasoning models spend part of this budget thinking, and that spend counts
# here. Below roughly 3000 a reasoning model can run out mid-thought and
# return truncated JSON.
MAX_TOKENS=4000

TEMPERATURE=0.0
